{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@test-fixtures/*": ["./test-fixtures/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "test-fixtures/**/*"]
}
